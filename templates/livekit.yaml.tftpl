port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000
  use_external_ip: true

redis:
  address: localhost:6379
  username: ""
  password: ""


keys:
  ${api_key}: ${api_secret}

webhook:
  api_key: ${api_key}
  urls:
    - ${webhook_url}

logging:
  json: false
  level: info